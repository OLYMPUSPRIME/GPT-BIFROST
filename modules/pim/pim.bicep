targetScope = 'subscription'

// INPUT SOURCE: Supply this value through the deployment parameters JSON file
// (for example, modules/pim/pim.parameters.json) or override it in the deployment command.
// Get the object ID from Microsoft Entra ID > Users/Groups > select the target identity > Object ID.
// For a service principal, use its Enterprise application/service principal Object ID, not the app/client ID.
@description('Microsoft Entra object ID of the user, group, or service principal that will receive eligible access.')
param principalId string

// INPUT SOURCE: Supply the full role definition resource ID in the deployment parameters JSON file.
// Find built-in/custom roles under the target subscription's Access control (IAM) > Roles,
// or query with Azure CLI: az role definition list --name '<role-name>' --query '[0].id' -o tsv.
// The role must be supported for Azure resource PIM at the target scope.
@description('Full Azure role definition resource ID, for example /subscriptions/<subscriptionId>/providers/Microsoft.Authorization/roleDefinitions/<roleGuid>.')
param roleDefinitionId string

// INPUT SOURCE: Set this in the deployment parameters JSON file based on the approved PIKE request,
// ticket, or change record. It explains why the eligible privileged access is being requested.
@description('Reason for requesting eligible privileged access.')
param justification string

// INPUT SOURCE: Optional value in the deployment parameters JSON file.
// If omitted, the module uses P90D. Use an ISO 8601 duration such as P30D, P90D, or P365D,
// in accordance with your organization's access policy.
@description('Eligibility duration in ISO 8601 format, for example P90D or P365D.')
param duration string = 'P90D'

// INPUT SOURCE: Optional override in the deployment parameters JSON file.
// If omitted, the deployment-time UTC value is used. Confirm the accepted date-time format
// for the selected API version before production deployment.
@description('Optional start date and time in UTC. Defaults to the current deployment time.')
param startDateTime string = utcNow('u')

// INPUT SOURCE: Usually omit this from the parameters JSON file.
// When omitted, Bicep generates a deterministic GUID from the subscription, principal, and role.
// Provide a value only if your workflow explicitly manages request names.
@description('Optional request name. If omitted, a stable GUID is generated from the target scope, principal, and role.')
param requestName string = guid(subscription().id, principalId, roleDefinitionId, 'pim-eligibility')

// INPUT SOURCE: Optional override in the deployment parameters JSON file.
// Choose the type matching the target principal: User, Group, or ServicePrincipal.
// The default is User.
@description('Principal type for the eligible assignment.')
@allowed([
  'User'
  'Group'
  'ServicePrincipal'
])
param principalType string = 'User'

// Creates an Azure RBAC PIM eligibility schedule request at the subscription deployment scope.
// This creates eligibility; it does not activate the role or grant active permissions immediately.
resource eligibleAssignment 'Microsoft.Authorization/roleEligibilityScheduleRequests@2022-04-01-preview' = {
  name: requestName
  properties: {
    principalId: principalId
    principalType: principalType
    roleDefinitionId: roleDefinitionId
    requestType: 'AdminAssign'
    justification: justification
    scheduleInfo: {
      startDateTime: startDateTime
      expiration: {
        type: 'AfterDuration'
        duration: duration
      }
    }
  }
}

// Outputs are generated by Azure after deployment; they are not input parameters.
output eligibilityRequestId string = eligibleAssignment.id
output eligibilityRequestName string = eligibleAssignment.name
