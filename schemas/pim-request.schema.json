{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prometheus-n.github.io/BIFROST/schemas/pim-request.schema.json",
  "title": "BIFROST Jira-generated PIM request",
  "description": "Schema for runtime request JSON generated by Jira automation. Request values must not override administrator PIM policy.",
  "type": "object",
  "required": ["request", "subscription", "pimRequest"],
  "additionalProperties": false,
  "properties": {
    "request": {
      "type": "object",
      "required": ["ticketNumber", "ticketSystem", "requestedBy", "approved", "environment", "project", "justification"],
      "additionalProperties": false,
      "properties": {
        "ticketNumber": {"type": "string", "minLength": 1},
        "ticketSystem": {"type": "string", "const": "Jira"},
        "requestedBy": {"type": "string", "minLength": 1},
        "approved": {"type": "boolean"},
        "environment": {"type": "string", "enum": ["dev", "test", "staging", "prod"]},
        "project": {"type": "string", "const": "BIFROST"},
        "justification": {"type": "string", "minLength": 1}
      }
    },
    "subscription": {
      "type": "object",
      "required": ["subscriptionId"],
      "additionalProperties": false,
      "properties": {
        "subscriptionId": {"type": "string", "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"}
      }
    },
    "pimRequest": {
      "type": "object",
      "required": ["platform", "principal", "role", "scope", "assignment"],
      "additionalProperties": false,
      "properties": {
        "platform": {"type": "string", "enum": ["AzureResource", "EntraDirectoryRole", "PIMGroup"]},
        "principal": {
          "type": "object",
          "required": ["type", "objectId"],
          "additionalProperties": false,
          "properties": {
            "type": {"type": "string", "enum": ["User", "Group", "ServicePrincipal"]},
            "objectId": {"type": "string", "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"}
          }
        },
        "role": {
          "type": "object",
          "required": ["name", "roleDefinitionId"],
          "additionalProperties": false,
          "properties": {
            "name": {"type": "string", "minLength": 1},
            "roleDefinitionId": {"type": "string", "minLength": 1}
          }
        },
        "scope": {
          "type": "object",
          "required": ["type", "resourceGroupName", "resourceId"],
          "additionalProperties": false,
          "properties": {
            "type": {"type": "string", "enum": ["Subscription", "ResourceGroup", "Resource"]},
            "resourceGroupName": {"type": "string"},
            "resourceId": {"type": "string"}
          }
        },
        "assignment": {
          "type": "object",
          "required": ["type", "startDateTime", "expiration"],
          "additionalProperties": false,
          "properties": {
            "type": {"type": "string", "enum": ["Eligible", "Active"]},
            "startDateTime": {"type": "string"},
            "expiration": {
              "type": "object",
              "required": ["type", "duration", "endDateTime"],
              "additionalProperties": false,
              "properties": {
                "type": {"type": "string", "enum": ["AfterDuration", "AfterDateTime", "NoExpiration"]},
                "duration": {"type": "string"},
                "endDateTime": {"type": "string"}
              }
            }
          }
        }
      }
    }
  }
}
